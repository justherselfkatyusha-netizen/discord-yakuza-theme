:root {
  --bg-image: url("https://media.discordapp.net/attachments/1404619877016408229/1491746595660759090/dragon.jpg");

  --yakuza-red-dark: #6e0f0f;
  --yakuza-red-darker: #4d0909;
  --yakuza-red-lightglass: rgba(120, 30, 30, 0.18);
  --yakuza-red-lightglass-2: rgba(140, 35, 35, 0.22);

  --text-main: #f3eeee;
  --text-muted-custom: #c9b4b4;
  --name-red: #7b1818;

  --panel-border: rgba(180, 70, 70, 0.18);
  --panel-shadow: rgba(0, 0, 0, 0.32);
}

/* =========================
   FORCE BACKGROUND
========================= */

html,
body,
#app-mount,
.appMount-2yBXZl,
.app-2CXKsg,
.bg-1QIAus,
.layer-86YKbF,
.base-2jDfDU {
  background: var(--bg-image) center/cover no-repeat fixed !important;
  background-color: transparent !important;
}

/* kill most default solid backgrounds without nuking everything */
.theme-dark,
.visual-refresh,
.layers-OrUESM,
.container__133bf,
.wrapper__9916c,
.bg__12180,
.contentRegion__08eba,
.sidebarRegionScroller__1fa7e,
.standardSidebarView__12528 {
  background: transparent !important;
  background-color: transparent !important;
}

/* readability overlay */
#app-mount::before,
.appMount-2yBXZl::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.32),
      rgba(0, 0, 0, 0.52)
    );
  pointer-events: none;
  z-index: 0;
}

/* make sure UI sits above overlay */
.app-2CXKsg,
.bg-1QIAus,
.layer-86YKbF,
.base-2jDfDU,
.sidebar-1tnWFu,
.chat-2ZfjoI,
.membersWrap-3NUR2t,
.container-ZMc96U,
.standardSidebarView-E9Pc3j {
  position: relative;
  z-index: 1;
}

/* =========================
   GLASS PANELS
   slightly transparent lighter red
========================= */

.sidebar-1tnWFu,
.container-1NXEtd,
.chat-2ZfjoI,
.container-ZMc96U,
.members-3WRCEx,
.membersWrap-3NUR2t,
.panels-3wFtMD,
.container-2o3qEW,
.content-1jQy2l,
.container-1eFtFS,
.applicationStore-2nk7Lo,
.pageWrapper-2PwDoS,
.scroller-22Maiq,
.nowPlayingColumn-1eCBCN,
.peopleColumn-1wMU14,
.standardSidebarView-E9Pc3j,
.contentRegion-3HkfJJ,
.sidebarRegion-1VBisG,
.form-3gdLxP,
.channelTextArea-1FufC0,
.scrollableContainer-15eg7h {
  background: linear-gradient(
    180deg,
    var(--yakuza-red-lightglass),
    var(--yakuza-red-lightglass-2)
  ) !important;
  backdrop-filter: blur(10px) saturate(110%) !important;
  -webkit-backdrop-filter: blur(10px) saturate(110%) !important;
  border: 1px solid var(--panel-border) !important;
  box-shadow:
    0 0 12px var(--panel-shadow),
    0 0 10px rgba(80, 0, 0, 0.10) !important;
}

/* slightly deeper top/header bars */
.title-31SJ6t,
.header-3OsQeK,
.children-3xh0VB {
  background: rgba(90, 18, 18, 0.20) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
  border-bottom: 1px solid rgba(170, 70, 70, 0.12) !important;
}

/* =========================
   DARKER RED NAMES
========================= */

.username-h_Y3Us,
.username-1A8OIy,
.name-3Uvkvr,
.title-17SveM,
.headerText-2z4IhQ,
.nickname-3P1RuO,
.memberInner-2CPc3V,
.member-2gU6Ar .name-3Vmqxm,
.layout-1qmrhw .name-3Vmqxm,
.markup-eYLPri strong {
  color: var(--name-red) !important;
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.18) !important;
}

/* normal readable text */
.defaultColor-1EVLSt,
.markup-eYLPri,
.contents-3ca1mk,
.topic-11NuQZ,
.subtitle-3PyFgf {
  color: var(--text-main) !important;
}

.description-22d6ux,
.text-sm-normal-AEQz4v,
.text-xs-normal-3SiVjE,
.channelInfo-3jN1ay,
.repliedTextPreview-1bvxun {
  color: var(--text-muted-custom) !important;
}

/* =========================
   CHANNELS / SELECTED ITEMS
========================= */

.modeSelected-3DmyhH,
.interactiveSelected-29CP8y,
.selected-1Drb7Z {
  background: rgba(90, 10, 10, 0.26) !important;
  border-left: 2px solid var(--yakuza-red-dark) !important;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.22) !important;
}

.modeSelected-3DmyhH .name-3Uvkvr,
.interactiveSelected-29CP8y .name-3Uvkvr,
.selected-1Drb7Z .name-3Uvkvr {
  color: #8a1616 !important;
}

/* =========================
   HOVER GLOW - BLACK
   "mouse pointer position glow black"
========================= */

button:hover,
[role="button"]:hover,
.clickable-28SzVr:hover,
.channel-1Shao0:hover,
.member-2gU6Ar:hover,
.layout-1qmrhw:hover,
.wrapper-NhbLHG:hover,
.interactive-1vLZ_I:hover,
.item-2LIpTv:hover,
.message-2CShn3:hover {
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.10),
    0 0 12px rgba(0, 0, 0, 0.38) !important;
}

/* =========================
   BUTTONS
========================= */

.button-12Fmur,
.lookFilled-yCfaCM {
  background: linear-gradient(
    180deg,
    rgba(120, 18, 18, 0.95),
    rgba(70, 8, 8, 0.95)
  ) !important;
  color: #f6eeee !important;
  border: 1px solid rgba(150, 50, 50, 0.20) !important;
}

.button-12Fmur:hover,
.lookFilled-yCfaCM:hover {
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.14),
    0 0 14px rgba(0, 0, 0, 0.42) !important;
}

/* links/icons */
a,
.anchor-1MIwyf,
.icon-2xnN2Y,
.icon-1Y-Gpt {
  color: #8f1919 !important;
}

/* =========================
   MESSAGE INPUT
========================= */

.scrollableContainer-15eg7h,
.channelTextArea-1FufC0 {
  background: rgba(115, 28, 28, 0.20) !important;
  border: 1px solid rgba(155, 60, 60, 0.16) !important;
}

/* =========================
   THINNER DARKER RED SCROLLBAR
========================= */

::-webkit-scrollbar {
  width: 7px !important;
  height: 7px !important;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(
    180deg,
    #5a0b0b,
    #3b0707
  ) !important;
  border-radius: 999px !important;
  border: none !important;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(
    180deg,
    #6b0d0d,
    #470808
  ) !important;
}

::-webkit-scrollbar-track {
  background: rgba(25, 0, 0, 0.18) !important;
  border-radius: 999px !important;
}

/* firefox fallback */
* {
  scrollbar-width: thin !important;
  scrollbar-color: #4a0909 rgba(25, 0, 0, 0.18) !important;
}

/* =========================
   SERVER ICONS / PANELS
========================= */

.wrapper-28eC3z:hover,
.childWrapper-1j_1ub:hover {
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.10),
    0 0 12px rgba(0, 0, 0, 0.35) !important;
}

/* =========================
   EXTRA FIXES FOR BACKGROUND BLEED
========================= */

.chatContent-3KubbW,
.messagesWrapper-RpOMA3,
.content-1SgpWY,
.container-36u7Lw,
.membersWrap-3NUR2t,
.privateChannels-oVe7HL,
.scroller-WSmht3,
.scrollerBase-_bVAAt,
.container__2637a,
.contentRegionScroller__86c79,
.sidebarRegionScroller__1fa7e {
  background: transparent !important;
}

/* make message area slightly clearer without killing background */
.message-2CShn3 {
  background: transparent !important;
}

/* soft black hover line */
.message-2CShn3:hover {
  background: rgba(255, 255, 255, 0.02) !important;
  box-shadow: inset 2px 0 0 rgba(0, 0, 0, 0.35) !important;
}
