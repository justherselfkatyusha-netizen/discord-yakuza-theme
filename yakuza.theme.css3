:root {
  --yakuza-red: rgba(200, 20, 20, 0.95);
  --yakuza-red-soft: rgba(255, 40, 40, 0.35);
  --glass-dark: rgba(10, 10, 10, 0.45);
  --glass-darker: rgba(5, 5, 5, 0.58);
  --text-main: #f5f5f5;
  --text-muted-custom: #c9c9c9;
}

/* FORCE THE WALLPAPER TO EXIST */
html,
body {
  background: url("https://media.discordapp.net/attachments/1404619877016408229/1491746595660759090/dragon.jpg") center/cover no-repeat fixed !important;
  background-color: transparent !important;
  min-height: 100vh !important;
}

/* REMOVE DISCORD'S SOLID BACKGROUNDS */
body,
.theme-dark,
.appMount-2yBXZl,
.bg-1QIAus,
.layer-86YKbF,
.app-2CXKsg,
.container-2cd8Mz,
.themed-Hp1KC_,
.wrapper-1_HaEi,
.base-2jDfDU {
  background: transparent !important;
  background-color: transparent !important;
}

/* MAIN WALLPAPER HOLDER */
.appMount-2yBXZl {
  background: url("https://media.discordapp.net/attachments/1404619877016408229/1491746595660759090/dragon.jpg") center/cover no-repeat fixed !important;
  position: relative !important;
}

/* DARK OVERLAY FOR READABILITY */
.appMount-2yBXZl::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.45),
      rgba(0, 0, 0, 0.72)
    );
  pointer-events: none;
  z-index: 0;
}

/* KEEP UI ABOVE OVERLAY */
.app-2CXKsg,
.bg-1QIAus,
.layer-86YKbF,
.base-2jDfDU,
.sidebar-1tnWFu,
.chat-2ZfjoI,
.membersWrap-3NUR2t,
.container-ZMc96U,
.standardSidebarView-E9Pc3j {
  position: relative;
  z-index: 1;
}

/* GLASS PANELS */
.sidebar-1tnWFu,
.container-1NXEtd,
.chat-2ZfjoI,
.container-ZMc96U,
.members-3WRCEx,
.membersWrap-3NUR2t,
.panels-3wFtMD,
.container-2o3qEW,
.content-1jQy2l,
.container-1eFtFS,
.applicationStore-2nk7Lo,
.pageWrapper-2PwDoS,
.scroller-22Maiq,
.nowPlayingColumn-1eCBCN,
.peopleColumn-1wMU14,
.standardSidebarView-E9Pc3j,
.contentRegion-3HkfJJ,
.sidebarRegion-1VBisG {
  background: var(--glass-dark) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  box-shadow:
    0 0 18px rgba(0, 0, 0, 0.35),
    0 0 18px rgba(255, 30, 30, 0.08) !important;
}

/* TOP BAR / HEADER */
.title-31SJ6t,
.container-ZMc96U,
.header-3OsQeK,
.children-3xh0VB {
  background: rgba(15, 15, 15, 0.35) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
}

/* MESSAGE INPUT */
.form-3gdLxP,
.channelTextArea-1FufC0,
.scrollableContainer-15eg7h {
  background: rgba(15, 15, 15, 0.52) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(255, 50, 50, 0.20) !important;
  box-shadow: 0 0 12px rgba(255, 0, 0, 0.12) !important;
}

/* RED GLOW ACCENTS */
.button-12Fmur,
.lookFilled-yCfaCM,
.item-2LIpTv,
.selected-1Drb7Z,
.modeSelected-3DmyhH,
.tabBarItem-30Te4-,
.interactiveSelected-29CP8y,
.clickable-28SzVr:hover,
.wrapper-NhbLHG:hover,
.channel-1Shao0:hover {
  box-shadow:
    0 0 8px rgba(255, 25, 25, 0.35),
    0 0 18px rgba(255, 0, 0, 0.18) !important;
}

/* SELECTED CHANNEL / TAB */
.modeSelected-3DmyhH .name-3Uvkvr,
.interactiveSelected-29CP8y,
.selected-1Drb7Z {
  color: #fff !important;
  text-shadow: 0 0 8px rgba(255, 40, 40, 0.55) !important;
  background: rgba(120, 0, 0, 0.22) !important;
  border-left: 2px solid var(--yakuza-red) !important;
}

/* BUTTONS */
.lookFilled-yCfaCM {
  background: linear-gradient(180deg, rgba(170, 18, 18, 0.95), rgba(95, 0, 0, 0.95)) !important;
  color: white !important;
  border: 1px solid rgba(255, 120, 120, 0.18) !important;
}

/* LINKS / ICONS */
a,
.anchor-1MIwyf,
.contents-3ca1mk,
.icon-2xnN2Y,
.icon-1Y-Gpt {
  color: #ff5a5a !important;
}

/* NORMAL TEXT */
.username-h_Y3Us,
.username-1A8OIy,
.name-3Uvkvr,
.title-17SveM,
.defaultColor-1EVLSt,
.markup-eYLPri {
  color: var(--text-main) !important;
}

/* MUTED TEXT */
.subtitle-3PyFgf,
.description-22d6ux,
.text-sm-normal-AEQz4v,
.text-xs-normal-3SiVjE {
  color: var(--text-muted-custom) !important;
}

/* MESSAGE HOVER */
.message-2CShn3:hover {
  background: rgba(255, 255, 255, 0.03) !important;
  box-shadow: inset 2px 0 0 rgba(255, 50, 50, 0.22) !important;
}

/* MEMBER LIST HOVER */
.member-2gU6Ar:hover,
.layout-1qmrhw:hover {
  background: rgba(255, 255, 255, 0.04) !important;
  box-shadow: inset 2px 0 0 rgba(255, 40, 40, 0.20) !important;
}

/* SERVER ICON HOVER GLOW */
.wrapper-28eC3z:hover,
.childWrapper-1j_1ub:hover {
  box-shadow:
    0 0 10px rgba(255, 30, 30, 0.35),
    0 0 20px rgba(255, 0, 0, 0.18) !important;
}

/* SCROLLBAR */
::-webkit-scrollbar-thumb {
  background: rgba(170, 20, 20, 0.65) !important;
  border-radius: 10px !important;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.18) !important;
}
